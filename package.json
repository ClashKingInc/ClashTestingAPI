{
  "name": "clash-of-clans-mock-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/clash-contract"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "check": "npm run format:check && npm run typecheck && npm run check:generated && npm run test:http-contract && npm run test:bundle && npm run test:package",
    "build": "wrangler deploy --dry-run --env= --outdir dist",
    "deploy": "wrangler deploy --env=",
    "deploy:staging": "wrangler deploy --env staging",
    "types": "wrangler types",
    "typecheck": "npm run build -w @clashking/clash-contract && tsc --noEmit && npm run test:types -w @clashking/clash-contract",
    "generate": "node --import tsx scripts/generate.ts",
    "check:generated": "node --import tsx scripts/generate.ts --check",
    "test:bundle": "npm run build && node --import tsx scripts/smoke-worker.ts",
    "test:package": "node --import tsx scripts/smoke-package.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:contract": "npm pack -w @clashking/clash-contract",
    "test:http-contract": "npm run build && node --import tsx scripts/verify-http-contract.ts"
  },
  "dependencies": {
    "@clashking/clash-contract": "1.1.1",
    "effect": "4.1.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20260903.0-alpha",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  }
}
