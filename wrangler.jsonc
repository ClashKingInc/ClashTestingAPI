{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clash-of-clans-mock-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "mock.clashk.ing", "custom_domain": true }],
  "env": {
    "staging": { "name": "clash-of-clans-mock-api-staging", "routes": [] },
  },
}
